APP_ENV=development
# Paths default to this repository. Lists below use JSON syntax.
# WORKSPACE_ROOT=D:/AgentRe
# ALLOWED_ROOTS=["D:/AgentRe"]
# PAPERS_DIR=D:/AgentRe/data/papers
# RUNTIME_DIR=D:/AgentRe/data/runtime
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Use a model service supporting the Chat Completions HTTP protocol and JSON output.
# The base URL includes /v1; do not append /chat/completions here.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_JSON_MODE=true
# Optional; DeepSeek: none disables thinking for schema-based extraction.
MODEL_REASONING_EFFORT=
MODEL_TOKEN_PARAMETER=max_completion_tokens
MODEL_MAX_TOKENS=4000
MODEL_TIMEOUT_SECONDS=90
MAX_MODEL_CALLS=24
MAX_REVISION_ROUNDS=2
MAX_CONCURRENT_REVIEWS=2
MAX_PAPERS=40
MAX_PAGES_PER_PDF=300
MAX_TOTAL_PAGES=1500
MAX_PDF_BYTES=30000000
PDF_TIMEOUT_SECONDS=45
MAX_REQUEST_BYTES=2000000
MAX_PROMPT_CHARS=65000
