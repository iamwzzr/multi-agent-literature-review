{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: start",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "35549"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest",
        "backend/tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: start",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "start-frontend.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: install",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "frontend.cmd ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Development: start both",
      "dependsOn": [
        "Backend: start",
        "Frontend: start"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
